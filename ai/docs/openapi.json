          "destinations",
          "start_date",
          "end_date"
        ],
        "title": "TripContextSchema",
        "type": "object"
      },
      "UnplacedMustVisitSchema": {
        "additionalProperties": false,
        "description": "미배치 필수방문 보고 1건 (TRIP-350 — PR #104에서 확정한 회신 계약).\n\n배경(TRIP-328): 백엔드가 기간 밖 must_visit을 fixed_blocks에 실어 보내면\nHC3가 범위 밖 날짜를 스킵해 **침묵 드롭**됐다 — 이 필드가 \"왜 안 들어갔는지\"를\n돌려준다. `reason_code`는 **닫힌 집합**(백엔드가 분기·화면 문구에 사용):\n\n- `OUT_OF_RANGE`: 고정 블록 날짜가 여행 기간(trip_context) 밖\n- `WINDOW_CONFLICT`: 기간 안 미배치 + 다른 고정 블록과 시간 겹침이 증명됨\n- `NO_FEASIBLE_SLOT`: 그 외 미배치 (기간 안·겹침 없음인데 해에 없음)",
        "properties": {
          "poi_id": {
            "minLength": 1,
            "title": "Poi Id",
            "type": "string"
          },
          "reason_code": {
            "enum": [
              "OUT_OF_RANGE",
              "NO_FEASIBLE_SLOT",
              "WINDOW_CONFLICT"
            ],
            "title": "Reason Code",
            "type": "string"
          }
        },
        "required": [
          "poi_id",
          "reason_code"
        ],
        "title": "UnplacedMustVisitSchema",
        "type": "object"
      },
      "ValidateItineraryRequest": {
        "additionalProperties": false,
        "description": "`POST /ai/v1/itinerary/validate` — 백엔드 포트 `validate(solution)` 대응 + IO-1.",
        "properties": {
          "itinerary": {
            "$ref": "#/components/schemas/ItineraryPayload"
          },
          "request_meta": {
            "$ref": "#/components/schemas/RequestMetaSchema"
