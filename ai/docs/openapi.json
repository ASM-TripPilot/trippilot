        "additionalProperties": false,
        "description": "빈 목록 = 위반 없음. 상태코드는 200(위반은 정상 응답, IO-7).",
        "properties": {
          "violations": {
            "items": {
              "$ref": "#/components/schemas/ViolationSchema"
            },
            "title": "Violations",
            "type": "array"
          }
        },
        "title": "ValidateItineraryResponse",
        "type": "object"
      },
