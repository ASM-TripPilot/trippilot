              },
              {
                "type": "null"
              }
            ],
            "title": "Distance Range"
          },
          "end_at": {
            "format": "time",
            "title": "End At",
            "type": "string"
          },
          "ends_next_day": {
            "default": false,
            "title": "Ends Next Day",
            "type": "boolean"
          },
          "is_fixed": {
            "default": false,
            "title": "Is Fixed",
            "type": "boolean"
          },
          "poi_id": {
            "title": "Poi Id",
            "type": "string"
          },
          "start_at": {
            "format": "time",
            "title": "Start At",
            "type": "string"
          }
        },
        "required": [
          "poi_id",
          "start_at",
          "end_at"
        ],
        "title": "VisitSlotDisplaySchema",
        "type": "object"
      }
    }
