{
  "components": {
    "schemas": {
      "CandidatesSummarySchema": {
        "additionalProperties": false,
        "description": "후보 충분성(BR-U2-05). 판정은 AI 소유 — 백엔드는 그대로 전달한다.\n\n`pool_size`는 모르면 null로 둔다(0은 \"후보 0건\"이라는 판정으로 읽힌다).",
        "properties": {
          "level": {
            "title": "Level",
            "type": "string"
          },
          "pool_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pool Size"
          },
          "shortfall_categories": {
            "items": {
              "type": "string"
            },
            "title": "Shortfall Categories",
            "type": "array"
          }
        },
        "required": [
          "level"
        ],
        "title": "CandidatesSummarySchema",
        "type": "object"
      },
      "DayAnchorSchema": {
        "additionalProperties": false,
        "description": "day별 공간 앵커(등록 숙소 해석 결과 = trip_base_day).",
        "properties": {
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "lat": {
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat",
            "type": "number"
          },
          "lng": {
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lng",
            "type": "number"
          }
        },
        "required": [
          "date",
          "lat",
          "lng"
        ],
        "title": "DayAnchorSchema",
        "type": "object"
      },
      "DayScheduleSchema": {
        "additionalProperties": false,
        "properties": {
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "slots": {
            "items": {
              "$ref": "#/components/schemas/VisitSlotDisplaySchema"
            },
            "title": "Slots",
            "type": "array"
          }
        },
        "required": [
          "date"
        ],
        "title": "DayScheduleSchema",
        "type": "object"
      },
      "FixedBlockSchema": {
        "additionalProperties": false,
        "description": "시각 고정 필수방문지(HC3). ANYTIME이면 date/start/dwell_min은 null.",
        "properties": {
          "date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date"
          },
          "dwell_min": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dwell Min"
          },
          "poi_id": {
            "minLength": 1,
            "title": "Poi Id",
            "type": "string"
          },
          "start": {
            "anyOf": [
              {
                "format": "time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start"
          }
        },
        "required": [
          "poi_id"
        ],
        "title": "FixedBlockSchema",
        "type": "object"
      },
      "FreshnessMetaSchema": {
        "additionalProperties": false,
        "description": "IO-6 — 사용 데이터 신선도. 백엔드는 `fetched_at`→generatedAt, `stale`→degraded로 사영한다.",
        "properties": {
          "cache_hit": {
            "default": false,
            "title": "Cache Hit",
            "type": "boolean"
          },
          "fetched_at": {
            "format": "date-time",
            "title": "Fetched At",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "stale": {
            "default": false,
            "title": "Stale",
            "type": "boolean"
          },
          "ttl_sec": {
            "default": 0,
            "title": "Ttl Sec",
            "type": "integer"
          }
        },
        "required": [
          "source",
          "fetched_at"
        ],
        "title": "FreshnessMetaSchema",
        "type": "object"
      },
      "GenerateItineraryRequest": {
        "additionalProperties": false,
        "description": "`POST /ai/v1/itinerary/generate` 요청 = 백엔드 `ScheduleAgentInput`.\n\nday1 2단계 생성(TRIP-293): 1차 `time_windows=[day1]`·`deadline_ms=5000`,\n2차 `time_windows=[나머지]`·`excluded_poi_ids=[1차 배정 POI]`.",
        "properties": {
          "anchors": {
            "items": {
              "$ref": "#/components/schemas/DayAnchorSchema"
            },
            "title": "Anchors",
            "type": "array"
          },
          "excluded_poi_ids": {
            "items": {
              "type": "string"
            },
            "title": "Excluded Poi Ids",
            "type": "array"
          },
          "fixed_blocks": {
            "items": {
              "$ref": "#/components/schemas/FixedBlockSchema"
            },
            "title": "Fixed Blocks",
            "type": "array"
          },
          "generation_mode": {
            "$ref": "#/components/schemas/GenerationMode"
          },
          "preference_profile": {
            "$ref": "#/components/schemas/PreferenceProfileSchema"
          },
          "recommendation_strength": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recommendation Strength"
          },
          "request_meta": {
            "$ref": "#/components/schemas/RequestMetaSchema"
          },
          "time_windows": {
            "items": {
              "$ref": "#/components/schemas/TimeWindowSchema"
            },
            "minItems": 1,
            "title": "Time Windows",
            "type": "array"
          },
          "trip_context": {
            "$ref": "#/components/schemas/TripContextSchema"
          },
          "trip_id": {
            "minLength": 1,
            "title": "Trip Id",
            "type": "string"
          }
        },
        "required": [
          "trip_id",
          "generation_mode",
          "trip_context",
          "time_windows",
          "preference_profile",
          "request_meta"
        ],
        "title": "GenerateItineraryRequest",
        "type": "object"
      },
      "GenerationMode": {
        "description": "d11 추천 강도 분기. 백엔드는 Kotlin enum 이름(대문자)을 보낸다.",
        "enum": [
          "FULLY_AI",
          "CO_PLAN"
        ],
        "title": "GenerationMode",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
