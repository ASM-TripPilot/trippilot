# TripPilot 모노레포 — Bazel 최소 적용.
#
# Bazel 이 소유하는 범위는 둘뿐이다.
#   1. ai 패키지의 빌드·테스트 (rules_python 네이티브)
#   2. backend·frontend·ai 컨테이너 이미지 (rules_oci 로 규칙 통일)
#
# backend 의 Gradle 과 frontend 의 pnpm 은 그대로 둔다. 두 툴체인은 각자
# 아키텍처 규칙(Konsist·ArchUnit)·테스트 러너(Kotest·Jest)·마이그레이션(Flyway)을
# 이미 게이트로 걸고 있어서, Bazel 로 옮기면 그 게이트를 전부 재구축해야 한다.
# 대신 just 가 세 툴체인의 공통 진입점 역할을 한다 (justfile 참조).

module(
    name = "trippilot",
    version = "0.1.0",
)

bazel_dep(name = "rules_python", version = "2.2.0")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")

# ── Python 툴체인 ──────────────────────────────────────────────
# ai/.python-version 과 맞춘다. 어긋나면 uv 로 만든 lock 과 Bazel 이
# 서로 다른 인터프리터를 쓰게 되어 휠 해석이 갈린다.
PYTHON_VERSION = "3.11"

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = PYTHON_VERSION,
)

# ai 의존성은 uv.lock 이 정본이다. requirements.txt 는 거기서 내보낸 파생물이며
# `just ai-lock` 으로 재생성한다 (직접 손대지 말 것).
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "ai_pip",
    python_version = PYTHON_VERSION,
    requirements_lock = "//ai:requirements.txt",
)
use_repo(pip, "ai_pip")

# ── 컨테이너 베이스 이미지 ──────────────────────────────────────
# digest 로 고정한다. 태그만 쓰면 같은 명령이 날마다 다른 이미지를 집어
# "내 로컬에선 됐는데" 가 생긴다. 갱신 방법은 deploy/README.md 참조.
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "temurin_jre",
    digest = "sha256:f19dbf0a22d0b3658fda48ce7d7181df05ad14bda151dd5ad12cc09d1451c70e",
    image = "docker.io/library/eclipse-temurin",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
    tag = "25-jre",
)
oci.pull(
    name = "nginx_alpine",
    digest = "sha256:5616878291a2eed594aee8db4dade5878cf7edcb475e59193904b198d9b830de",
    image = "docker.io/library/nginx",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
    tag = "1.29-alpine",
)
oci.pull(
    name = "python_slim",
    digest = "sha256:90744cff8f32887f075c47d747a173ff333e9e98801667af93c357fa9f5e28ff",
    image = "docker.io/library/python",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
    tag = "3.11-slim",
)
use_repo(oci, "nginx_alpine", "nginx_alpine_linux_amd64", "nginx_alpine_linux_arm64_v8", "python_slim", "python_slim_linux_amd64", "python_slim_linux_arm64_v8", "temurin_jre", "temurin_jre_linux_amd64", "temurin_jre_linux_arm64_v8")
