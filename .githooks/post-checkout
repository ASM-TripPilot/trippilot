#!/bin/sh
# post-checkout(로컬): 새 워크트리를 만들면(`git worktree add`·herdr worktree create) 리포 루트에
# `_workspace` → 옵시디언 볼트 `TripPilot/사이클/` 심볼릭 링크를 만든다. gitignore 라 git 이 만들어 주지 않고,
# 링크가 없으면 작업 노트가 워크트리 안 일반 폴더에 써져 워크트리를 지울 때 같이 사라진다(2026-11-01 실측 14폴더).
# 인자: $1 이전 HEAD, $2 새 HEAD, $3 브랜치 체크아웃 여부. 새 워크트리면 $1 이 0 으로만 된 값이다.
VAULT="${TRIPPILOT_VAULT:-$HOME/Library/Mobile Documents/iCloud~md~obsidian/Documents/Obsidian}/TripPilot/사이클"
TOP="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -d "$VAULT" ] || exit 0
[ -e "$TOP/_workspace" ] || [ -L "$TOP/_workspace" ] || ln -s "$VAULT" "$TOP/_workspace" && :
exit 0
