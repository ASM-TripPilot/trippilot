{
  "env": {
    "PONYTAIL_DEFAULT_MODE": "lite",
    "PONYTAIL_SUBAGENT_MATCHER": "^implementer$"
  },
  "model": "claude-opus-5-5[1m]",
  "includeCoAuthoredBy": false,
  "effortLevel": "medium",
  "permissions": {
    "deny": [
      "mcp__obsidian__obsidian_delete_file",
      "Bash(git stash:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout -- :*)",
      "Bash(git restore:*)"
    ]
  }
}
