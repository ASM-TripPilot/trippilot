{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api-dev.trippilot.co.kr"
      }
    },
    "production-dev-server": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://dev-api.trippilot.co.kr"
      }
    },
    "production-automation": {
      "extends": "production",
      "env": {
        "TRIPPILOT_LOCATION_AUTOMATION": "1",
        "EXPO_PUBLIC_TEST_REGIONS": "41190:부천"
      }
    },
    "production-automation-dev-server": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://dev-api.trippilot.co.kr",
        "TRIPPILOT_LOCATION_AUTOMATION": "1",
        "EXPO_PUBLIC_TEST_REGIONS": "41190:부천"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6819041997"
      }
    }
  }
}
