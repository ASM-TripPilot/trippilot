# 네이버 지도 SDK Client ID(TRIP-862) — NCP(네이버 클라우드 플랫폼) 콘솔에서 Maps 앱을 등록하고
# 발급받는다. iOS Bundle ID · Android Package Name 이 com.trippilot.travel 과 글자 단위로 정확히
# 일치해야 타일이 뜬다(불일치 시 인증 실패로 회색 화면만 — 조용히 실패). 무료 25,000/일·300,000/월.
# ⚠️ 로그인용 EXPO_PUBLIC_NAVER_CLIENT_ID 와는 다른 키다(등록 칸도 다름). 이 파일엔 값을 적지
# 마라(커밋된다) — 실값은 .env 에.
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=

# 소셜 로그인 네이티브 SDK(TRIP-210) — 카카오·네이버 콘솔에서 발급받는 로그인 전용 키다.
# 위 지도 JavaScript 키와는 다른 키·다른 등록 칸이니 헷갈리지 마라(§7-2 실측).
#   카카오: [내 애플리케이션] → [앱 키] → 네이티브 앱 키. iOS 는 커스텀 스킴
#           kakao{네이티브앱키} 등록 + 조회 스킴(LSApplicationQueriesSchemes) 허용도 필요하다.
#   네이버: consumerKey 는 기존 EXPO_PUBLIC_NAVER_CLIENT_ID 를 그대로 재사용한다(D2) — 이
#           변수를 새로 만들지 않는다. consumerSecret 은 네이버 SDK initialize() 의 필수
#           파라미터라 예외로 env 경유만 허용한다(D5 · frontend/README.md 참고).
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
EXPO_PUBLIC_NAVER_CLIENT_ID=
EXPO_PUBLIC_NAVER_CLIENT_SECRET=
EXPO_PUBLIC_NAVER_URL_SCHEME=

# 백엔드 API 주소(TRIP-936). 개발(__DEV__)에서 비우면 http://localhost:8080 폴백.
# ⚠️ 운영 빌드에서 비우면 앱이 시작 즉시 throw 한다(조용한 localhost 폴백 금지 — INV-4).
# EAS 원격 빌드는 이 파일·.env 를 올리지 않으므로 production/preview 프로필 env 에 공개 HTTPS
# 주소를 반드시 등록한다(EAS 대시보드 또는 eas env:create).
EXPO_PUBLIC_API_BASE_URL=

# 구글 로그인(브라우저 OAuth·PKCE, TRIP-1057) — Google Cloud 콘솔 → [API 및 서비스] → [사용자 인증 정보]
# → OAuth 클라이언트 ID **"iOS" 유형**(번들 ID com.trippilot.travel, app.config.ts)으로 발급한다.
# 공개 클라이언트라 시크릿이 없다 — 백엔드는 같은 클라이언트 ID 를 쓰고 GOOGLE_CLIENT_SECRET 은
# 비운다(루트 .env.example 참고). CLIENT_ID 가 비면 구글 버튼이 네트워크 전에 실패한다(makeAuthorize).
#   REDIRECT_URI 형식: com.googleusercontent.apps.{클라이언트 ID 의 .apps.googleusercontent.com 앞부분}:/oauthredirect
#                      (iOS 클라이언트의 역방향 스킴 — 콘솔 클라이언트 상세의 "iOS URL scheme" 값 + ":/oauthredirect")
#   SCOPES: 선택 — 비우면 'openid profile email'. 공백으로 구분.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=
EXPO_PUBLIC_GOOGLE_SCOPES=

# 카카오·네이버 브라우저 OAuth 폴백 — 위 네이티브 SDK 키(KAKAO_NATIVE_APP_KEY·NAVER_URL_SCHEME)가
# 비어 있을 때만 쓰인다(makeAuthorize resolveRoute). SDK 를 쓰면 비워 둔다.
#   카카오 CLIENT_ID = REST API 키, REDIRECT_URI = 카카오 콘솔에 등록한 리다이렉트 URI.
#   네이버 CLIENT_ID 는 위 EXPO_PUBLIC_NAVER_CLIENT_ID 를 재사용한다.
EXPO_PUBLIC_KAKAO_CLIENT_ID=
EXPO_PUBLIC_KAKAO_REDIRECT_URI=
EXPO_PUBLIC_NAVER_REDIRECT_URI=

# 개발용 가짜 로그인 — '1' 또는 'true' 면 실제 OAuth 없이 가짜 인가 코드를 돌려준다(dev 전용).
# OUTCOME: 비우면 성공, 'cancel'·'dismiss' 로 취소 경로를 재현한다.
EXPO_PUBLIC_AUTH_FAKE=
EXPO_PUBLIC_AUTH_FAKE_OUTCOME=
