# 네이버 지도 SDK Client ID(TRIP-862) — NCP(네이버 클라우드 플랫폼) 콘솔에서 Maps 앱을 등록하고
# 발급받는다. iOS Bundle ID · Android Package Name 이 com.trippilot.travel 과 글자 단위로 정확히
# 일치해야 타일이 뜬다(불일치 시 인증 실패로 회색 화면만 — 조용히 실패). 무료 25,000/일·300,000/월.
# ⚠️ 로그인용 EXPO_PUBLIC_NAVER_CLIENT_ID 와는 다른 키다(등록 칸도 다름). 이 파일엔 값을 적지
# 마라(커밋된다) — 실값은 .env 에.
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=

# 소셜 로그인 네이티브 SDK(TRIP-210) — 카카오·네이버 콘솔에서 발급받는 로그인 전용 키다.
# 위 지도 JavaScript 키와는 다른 키·다른 등록 칸이니 헷갈리지 마라(§7-2 실측).
#   카카오: [내 애플리케이션] → [앱 키] → 네이티브 앱 키. iOS 는 커스텀 스킴
#           kakao{네이티브앱키} 등록 + 조회 스킴(LSApplicationQueriesSchemes) 허용도 필요하다.
#   네이버: consumerKey 는 기존 EXPO_PUBLIC_NAVER_CLIENT_ID 를 그대로 재사용한다(D2) — 이
#           변수를 새로 만들지 않는다. consumerSecret 은 네이버 SDK initialize() 의 필수
#           파라미터라 예외로 env 경유만 허용한다(D5 · frontend/README.md 참고).
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
EXPO_PUBLIC_NAVER_CLIENT_ID=
EXPO_PUBLIC_NAVER_CLIENT_SECRET=
EXPO_PUBLIC_NAVER_URL_SCHEME=

# 백엔드 API 주소(TRIP-936). 개발(__DEV__)에서 비우면 http://localhost:8080 폴백.
# ⚠️ 운영 빌드에서 비우면 앱이 시작 즉시 throw 한다(조용한 localhost 폴백 금지 — INV-4).
# EAS 원격 빌드는 이 파일·.env 를 올리지 않으므로 production/preview 프로필 env 에 공개 HTTPS
# 주소를 반드시 등록한다(EAS 대시보드 또는 eas env:create).
EXPO_PUBLIC_API_BASE_URL=
