{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "environment": {
      "type": "string",
      "enum": [
        "dev",
        "prd"
      ]
    },
    "rolloutNonce": {
      "type": "string"
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "ai",
        "embedding",
        "gateway"
      ],
      "properties": {
        "backend": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9./:_-]*$"
            },
            "tag": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.-]*$"
            }
          }
        },
        "ai": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9./:_-]*$"
            },
            "tag": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.-]*$"
            }
          }
        },
        "embedding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9./:_-]*$"
            },
            "tag": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.-]*$"
            }
          }
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9./:_-]*$"
            },
            "tag": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.-]*$"
            }
          }
        }
      }
    },
    "imagePullPolicy": {
      "type": "string",
      "enum": [
        "Always",
        "IfNotPresent"
      ]
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "databaseHost": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?$"
        },
        "databasePort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "databaseName": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        },
        "databaseUser": {
          "const": "app_user"
        },
        "databaseMigrateUser": {
          "const": "app_migrate"
        },
        "redisHost": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?$"
        },
        "redisPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "scheduleDeadlineEnforced": {
          "type": "boolean"
        },
        "scheduleDeadlineDay1Ms": {
          "type": "integer",
          "minimum": 1
        },
        "scheduleDeadlineTotalMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "resources"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ]
        }
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "resources"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ]
        }
      }
    },
    "embedding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "resources"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ]
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "resources"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ]
        },
        "certificateArn": {
          "type": "string",
          "pattern": "^arn:aws[a-z-]*:acm:[a-z0-9-]+:[0-9]{12}:certificate/[a-f0-9-]{36}$"
        },
        "hostname": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-zA-Z0-9][a-zA-Z0-9.-]*[a-zA-Z0-9]$"
        },
        "loadBalancerSourceRanges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9.]+/[0-9]{1,2}$"
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "environment": {
            "const": "prd"
          }
        }
      },
      "then": {
        "properties": {
          "backend": {
            "properties": {
              "replicas": {
                "minimum": 2
              }
            }
          },
          "ai": {
            "properties": {
              "replicas": {
                "minimum": 2
              }
            }
          },
          "gateway": {
            "properties": {
              "replicas": {
                "minimum": 2
              }
            }
          },
          "podDisruptionBudget": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
