# 실패한 액션의 전체 명령줄을 보여준다 — 기본 출력만으로는
# 어떤 인자로 죽었는지 알 수 없어 디버깅이 추측이 된다.
build --verbose_failures

# 통과한 테스트 로그는 묻고 실패한 것만 펼친다.
test --test_output=errors

# 로컬 디스크 캐시. CI 는 각자 캐시를 쓰므로 여기서만 켠다.
build --disk_cache=~/.cache/bazel-disk/trippilot

# 사용자별 오버라이드 (커밋하지 않는다).
try-import %workspace%/.bazelrc.user
