# vault-rev: 8
#
# 여기에 넣는 건 **팀원 전원 로컬에 같은 값이 필요한 것**만이다. 개인 계정 발급 키
# (TOUR_API_KEY 등), CI 전용 키(NAVER_SEARCH_* 등), 특정 서버 전용 자격은 넣지 않는다
# — 분류 기준은 docs/guides/로컬-개발-컨테이너.md §1-2.
#
# 볼트 노트를 고치면 위 숫자를 +1 해서 커밋한다 → 팀원이 pull 할 때 갱신 알림이 뜬다.
# 로컬 개발 시크릿 템플릿 — 복사해서 사용: cp .env.example .env
# .env 는 git 에서 제외됨(.gitignore). 실제 값은 각자 로컬에만 둔다.

# DB 슈퍼유저(로컬 컨테이너 부트스트랩용)
POSTGRES_PASSWORD=postgres

# 런타임 앱이 붙을 롤 (init/00-roles.sql 에서 생성)
DB_USER=app_user
DB_PASSWORD=app_user

# 소셜 로그인 시크릿 — 각 IdP 개발자 콘솔에서 발급.
# 채워야 소셜 로그인이 동작한다(빈 값이면 로그인 시도 시에만 실패, 기동엔 무영향).
# ⚠️ 실제 값은 팀 비밀번호 매니저로 전달받아 채울 것. Slack/git 평문 공유 금지.
GOOGLE_CLIENT_ID=
# ⚠️ **비워 둔다.** 현재 GOOGLE_CLIENT_ID 는 시크릿이 없는 **공개(iOS) 클라이언트**라,
# client_secret 을 보내면 Google 이 invalid_client 로 거절한다(2026-09-23 실측 — 생략하면 통과).
# 백엔드는 빈 값이면 전송을 생략한다(AbstractOAuth2Client). Web 유형 클라이언트로 바꾸면 그때 채운다.
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 카카오 **앱 ID**(개발자 콘솔의 숫자 — REST API 키와 다르다. 시크릿 아님). SDK 토큰 로그인에서 그 토큰이
# 우리 앱에 발급된 것인지 대조한다(TRIP-1317). 비우면 대조하지 않는다(남의 앱 토큰으로 가입이 열린다).
KAKAO_APP_ID=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Apple 은 **시크릿이 없다** — 서버가 id_token 서명을 JWKS 로 검증할 뿐이라 iOS 번들 ID 하나뿐이다.
# 값은 Apple Developer 에 등록한 App ID = com.trippilot.travel (TRIP-858).
# 비우면 애플 로그인만 501(미지원)로 나간다 — 401 이 아니다. 나머지 동작엔 영향 없다.
APPLE_CLIENT_ID=
# 계정 삭제 시 Apple 토큰 revoke(TRIP-933 · App Store 5.1.1(v)) — 로그인에는 필요 없다.
# Apple Developer → Keys 에서 Sign in with Apple 키(.p8) 발급. Team ID 는 Membership 페이지 10자리.
# APPLE_PRIVATE_KEY 는 .p8 본문(헤더 포함 PEM 을 한 줄로 — 줄바꿈은 \n 으로 써도 된다). **시크릿이다.**
# SOCIAL_TOKEN_ENCRYPTION_KEY 는 Apple refresh_token 을 DB 에 암호화 저장하는 키(`openssl rand -base64 32`).
# 하나라도 비면 revoke 만 건너뛰고 경고 로그가 남는다.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
SOCIAL_TOKEN_ENCRYPTION_KEY=

# AI 일정 생성 경계 — 기본은 내장 Fake(AI 컨테이너 없이도 동작).
# 공동 통합테스트에서만 http 로 바꿔 실 AI 에 붙인다: docker compose --profile full up
# (fake|http 외의 값은 조용히 fake 로 남는다 — 기동 로그의 "일정 생성 경계 = ..." 줄로 확인할 것.)
AI_SCHEDULE_MODE=fake
# 일정 생성 시간제약을 AI 에 실을지. 코드·배포 기본은 true(TRIP-1000 · #866), 로컬 예시는 false =
# 시간제약 없음(TRIP-474 — FE 연동 중 시간 때문에 규칙 폴백으로 내려가는 것을 걷어낸다).
# 끄면 우리가 기다려 주는 상한이 전체 시한 → 610초가 되고, "멈춘 생성" 판정 기준도 함께 늘어난다.
AI_SCHEDULE_DEADLINE_ENFORCED=false

# 시한 **값**(위 플래그를 켰을 때만 쓰인다). 기본값은 코드(ScheduleDeadlineProperties)와 같은
# day1 15초 · 전체 60초다(TRIP-1000 — 종전 5초·20초는 상위 티어 모델이 사실상 못 타는 값이었다, 근거는 그 KDoc).
# 시한은 **목표치이지 하드 제약이 아니다**(PR #104, 2026-08-15 AI 트랙 제안 수용): AI 는 권고값으로
# 읽고 초과해도 완결 응답을 준다. SLO 지향점(day1 5초 · 전체 20초)을 넘는 값이면 기동 로그의 모드 공지가 경고한다.
# 소켓 read 상한은 여기서 파생하므로 따로 올릴 키가 없다.
AI_SCHEDULE_DAY1_DEADLINE_MS=15000
AI_SCHEDULE_TOTAL_DEADLINE_MS=60000
# AI 컨테이너 주소. compose 의 헬스핑과 경계 baseUrl 이 같이 쓴다.
AI_URL=http://ai:8000

# 지역 지오코딩 경계(국내강제 INV-U1-12) — 기본 스텁은 시드 8개(제주·부산·서울·경주·천안·속초시·사하구 등)만
# 국내로 알고 **나머지 지역명은 전부 국외로 판정해 차단한다**. 실 지역명으로 여행을 만들려면 kakao 로 바꾼다.
# 키는 위 KAKAO_CLIENT_ID(= 카카오 REST API 키)를 그대로 쓴다 — 별도 발급이 아니다.
# 단, 카카오 콘솔에서 카카오맵(OPEN_MAP_AND_LOCAL) 서비스를 켜야 한다(꺼져 있으면 403).
# kakao 인데 KAKAO_CLIENT_ID 가 비면 앱이 기동을 거부한다(국내강제가 조용히 꺼지는 것을 막는다).
PLACE_GEOCODE_MODE=stub

# 숙소 콘텐츠 경계 — 기본 스텁은 **제주 5곳뿐**이라 다른 지역 검색이 전부 0건이 된다.
# 그게 "그 지역에 숙소가 없다"로 읽히면 원인을 찾는 데 한참 걸린다(기동 로그가 어느 경로인지 남긴다).
# db 로 바꾸면 정본 테이블(stay, V2.26 + R__seed_stay.sql)의 **12,782곳**을 읽는다 —
# 시드가 채우므로 **외부 호출 0회 · 키 불필요**다. 켜지 않을 이유가 사실상 없다.
#
# ⚠ 켜도 **사진·가격은 안 나온다.** 원본이 LOCALDATA 인허가 대장이라 그 칸이 없고,
# 가격 스냅숏은 스텁 5건뿐이라 정본과 교집합이 0이다 — 화면은 "가격 미확인"(BR-U1-14)으로
# 그린다. 채우는 계획은 backend/docs/design/숙소콘텐츠-수집-설계.md.
#
# EKS 차트(deploy/eks/chart)와 로컬 k8s(deploy/k8s)는 **이미 db** 다 — compose 만 기본이 stub 이다.
STAY_CONTENT_MODE=db

# 서비스 간 호출 자격증명(TRIP-393) — AI 수집 워크플로 등 외부가 /internal 경계를 부를 때 쓴다.
# **비우면 /internal 은 아무도 호출할 수 없다**(fail-closed). 사용자 로그인 토큰으로는 통과하지 못한다.
# 팀 비밀번호 매니저로 공유하고 아무 랜덤 문자열이나 쓰면 된다(예: openssl rand -hex 32).
#
# **양방향 공용이다**(TRIP-856 부터). 백엔드→AI 발신도 같은 값을 X-Service-Token 으로 싣는다 —
# 상대가 한 곳이고, 갈라 두면 한 방향만 세팅된 절반 설정이 생긴다. 다만 발신 쪽은 **비어도 막지 않는다**
# (헤더 없이 호출). AI 가 아직 수신 검증을 켜지 않아서다 — 켜는 날 이 값이 양쪽에 있어야 한다.
#
# 로컬 compose 의 POI 자동 적재(poi-ingest)도 이 값으로 돈다 — 비면 적재를 건너뛰는데, 그 사실은
# `docker compose logs poi-ingest` 에만 한 줄 남는다(`up -d` 는 아무것도 출력하지 않는다).
SERVICE_AUTH_TOKEN=

# 켜면 위 값이 빈 채로는 **기동하지 않는다**. 배포 환경에서 켠다(로컬·CI 는 꺼 둔다).
# 발신 쪽이 조용한 것이 문제라서 있는 스위치다 — 수신은 비면 닫혀서 바로 드러나는데,
# 발신은 헤더 없이 그냥 나가고 상대가 검증을 켜는 날에야 401 로 나타난다.
#
# **AI 도 같은 값을 읽는다**(TRIP-878, 2026-09-19). AI 는 위 토큰이 있으면 인바운드
# 검증을 자동으로 켜고(`X-Service-Token` 불일치는 401), 이 스위치가 true 인데 토큰이
# 비어 있으면 기동하지 않는다. 이름을 공용으로 쓰는 이유는 토큰 자체가 양방향 공용이라
# "그 토큰이 반드시 있어야 한다"는 요구도 하나이기 때문이다 — 갈라 두면 한쪽만 켜진
# 절반 설정이 생긴다. `/health`·`/` 는 검증에서 면제다(헬스체크가 토큰을 안 들고 다닌다).
SERVICE_AUTH_REQUIRE_TOKEN=false

# 회고 AI 경계(O-U5-6) — rule(기본) | http.
# rule = 규칙 카드. http 로 켜면 회고 카드를 AI 가 만들고, 실패하면 규칙 카드로 폴백한다.
# AI 컨테이너가 떠 있어야 한다(`docker compose --profile full up -d ai`).
# ⚠️ **배포(EKS)는 항상 http 다.** 즉 여기를 rule 로 두면 로컬에서 한 번도 안 타 본 경로가
# 운영에서만 도는 상태가 된다 — 회고를 건드리는 작업이면 켜고 한 번은 확인할 것.
AI_REFLECTION_MODE=rule

# 리마인드 문구 AI 채움(TRIP-836) — off(기본) | http.
# 켜면 예약을 적재할 때 AI 에 문구를 한 번 묻고, 못 받으면 조용히 상수 문구로 간다.
# AI 컨테이너가 떠 있어야 한다(`docker compose --profile full up -d ai`).
AI_REMINDER_COPY_MODE=off
# JWT 서명키(RS256) — base64(PKCS#8) 개인키 **한 줄**. 공개키는 서버가 파생한다.
# **비우면 기동할 때마다 새로 만든다.** 단일 인스턴스 로컬에서는 무해하지만(재시작 시
# 액세스 토큰만 무효화되고 리프레시로 회복된다), **복제본을 둘 이상 띄우면 로그인이 깨진다** —
# A 가 서명한 토큰을 B 가 검증하지 못해 요청마다 무작위 401 이 난다.
# 만드는 법: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | openssl pkcs8 -topk8 -nocrypt -outform DER | base64
JWT_SIGNING_KEY=
# 켜면(true) 위 키가 빈 채로는 서버가 기동하지 않는다. 배포 환경에서 켠다.
# **비워 두지 말 것** — 빈 문자열은 Boolean 으로 바인딩되지 않아 기동이 깨진다. 끄려면 false.
JWT_REQUIRE_CONFIGURED_KEY=false

# 푸시 발송기(TRIP-834). off = LoggingPushAdapter — **아무 데도 안 보내면서 성공을 보고한다.**
# 지표는 그 경우 delivery=none 으로 갈리므로 "성공률 100%" 를 실발송으로 오독하지 않는다.
# expo 로 켜려면 실기기 push token 이 먼저 등록돼 있어야 하고, 켰는데 어댑터가 안 물리면 기동이 막힌다.
PUSH_MODE=off
# Expo access token — enhanced security 를 켠 프로젝트만 필요. 안 켰으면 **비워 둔다**
# (빈 Bearer 를 보내면 오히려 401).
PUSH_EXPO_ACCESS_TOKEN=

# TMAP 실경로 API(TRIP-432) — 설정 시 ChainedTravelAdapter 활성화(실경로 → 하버사인 폴백).
# 미설정 = 기존 하버사인 추정 그대로. SK open API 콘솔에서 appKey 발급.
TMAP_API_KEY=
# ODsay 대중교통 길찾기(2026-10-14) — 설정 시 대중교통 실측만 ODsay 가 맡고 자동차·보행은 TMAP 그대로.
# TMAP 대중교통 상품이 미구독(403)이라 넣었다. lab.odsay.com 콘솔에서 발급(서버 플랫폼이면 호출 IP 등록).
ODSAY_API_KEY=

# 행사 저장소 경로(TRIP-421) — **기본으로 배선돼 있다**(ai/data/collected_events.json, 이미지에 동봉).
# 행사 보너스를 끄려면 빈 값으로 두고 컨테이너를 다시 띄운다. 저장소 정본은 collect-state 브랜치:
#   git show origin/collect-state:collected_events.json > ai/data/collected_events.json
# ⚠️ 아래 줄의 `#` 를 풀면 기능이 **꺼진다** — 값을 그대로 둬도 compose 기본값과 같지만,
#    비운 채 풀면(AI_EVENTS_STORE=) 미배선이 된다. 기본 동작을 원하면 주석인 채로 둘 것.
#AI_EVENTS_STORE=data/collected_events.json

# ── AI 실 LLM·부가 기능 (전부 선택 — 비우면 해당 기능만 꺼지고 일정 생성은 동작) ──
# ⚠️ 이름 주의: compose 가 읽는 키는 정확히 아래 이름이다.
#   (예: LLM_PROVIDER 가 아니라 AI_LLM_PROVIDER — 이름이 다르면 조용히 꺼진다)

# 실 LLM 스위치 — openai | anthropic | mixed.
#   openai    → 아래 OPENAI_* 4종 필수 (GPT-5.6 게이트웨이)
#   anthropic → ANTHROPIC_API_KEY 필수 (Claude 직접 호출, AI-D06)
#   mixed     → 양쪽 키 전부 필수 — 기능별로 GPT·Claude 혼용 (TRIP-513).
#               배정은 AI_LLM_FEATURE_MODELS 로 ("claude*" 모델명이면 Claude 로 감).
# 켰는데 해당 키가 없으면 ai 기동 실패(의도된 fail-fast).
# 비우면 UnwiredLlm: 점수는 규칙 폴백, 일정은 OR-Tools 가 낸다(scoring_mode=RULE 로 표시).
AI_LLM_PROVIDER=
# GPT-5.6 게이트웨이(멘토 Azure v1 표면) — 값은 팀 비밀번호 매니저에서.
# BASE_URL 은 /openai/v1 까지만, MODEL 은 gpt-5.6-terra|sol|luna, API 는 responses 고정.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API=
# Claude 직접 호출용(anthropic 선택 시) — console.anthropic.com 발급.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# 기능별 모델 배정 콤마 목록 — "FEATURE=model,…". 티어 해석보다 우선한다(TRIP-513).
# mixed 전용이 아니다 — openai 단독에서도 배포(terra/sol/luna)를 기능별로 나눌 수 있다.
#
# 2026-10-14: Claude API 크레딧 소진으로 전 기능(LlmFeature 19종)을 GPT-5.6 으로 되돌렸다.
# 대응(사용자 지정): fable → sol · opus → terra · haiku → luna. 그래서 Fable 통일(10-11 #1038)
# 전에 opus-5 였던 회고 3종(REFLECTION_TEMPLATE·PHOTO_HIGHLIGHT·REFLECTION_TEMPLATE_VISION)은
# terra, haiku-4-5 였던 PARAPHRASE·REFLECTION_NUDGE 는 luna, 나머지는 sol. 이전 배정은 git 이력에 있다.
# 예외 REMINDER_COPY=terra(통일 전 값): 항목당 4초 몫(8s ÷ 2건)에 sol 은 6회 중 5회 타임아웃, terra 는 2회.
# REMINDER_COPY 의 terra 는 **ARN 없는 환경(CI 리허설·새 개발자)용 자리값**이다. DEV 시크릿과 로컬 .env 는
#   local-reminder-qwen3-4b-v1(파인튜닝 학생 모델, Bedrock CMI)로 돈다 — 원래 설계(AI-D08), 사용자 결정 2026-10-14.
#   정본을 local* 로 두면 전송로(ARN·base URL) 없는 곳에서 기동이 실패한다(main.py::_local_route). 아래 ② 참고.
# 전부 다 적는 이유: 리허설 워크플로가 mixed 로 돌아 **미배정 기능은 OPENAI_MODEL(terra)로 조용히 샌다.**
# REPLAN_COMPOSITION 은 sol 유지(2026-10-14 재측정). luna 는 재생 15건에선 동률·더 빨랐으나(#1190) 실 일정 하네스
#   (서울 첫날 11:50 × 사유·칩·자유입력 6종 × 3회)에서 구성 상한 18s 타임아웃 2/18(sol 0/18) — 하루를 고르는
#   판단이 통째로 폴백된다. 고른 내용(카페 추가 5/5 유지, 실내 지시에 야외 0)은 같았다. luna 는 다른 기능에서도 꼬리(20~45s)가 잦았다.
# 새 feature 를 추가하면 여기에도 한 항목 더할 것.
# 도우미 오케스트레이터 3종(DIALOGUE_INTENT·DIALOGUE_ANSWER·DIALOGUE_MEMORY, assistant-orchestrator 1단계)은 luna —
#   분류·답변·요약 전부 LIGHT 티어·effort low 라 10-14 대응표(haiku→luna, PARAPHRASE·REFLECTION_NUDGE 와 같은 줄)이고, 분류 상한 2.5s 안에
#   드는 것을 로컬 실측(10-18, 1.0~1.3s)으로 봤다. 켜는 길은 아래 AI_DIALOGUE_ORCHESTRATOR.
# ⚠️ 위 3종 추가분의 팀 볼트 노트·vault-rev 반영은 **보류 중**(잊음 아님, #459 와 같은 절차) — 볼트 노트는 사람이 고치고,
#   그때 vault-rev 를 +1 한다(#504 선례). DEV 시크릿 TRIPPILOT_LLM_FEATURE_MODELS 에도 같은 3항목을 더해야 배포에서 실린다.
# 기능별 effort 표(`llm_gateway/config.py` default_feature_effort)는 두 벤더 모두 싣는다 —
# Claude 는 output_config.effort, GPT 는 responses reasoning.effort(gpt-5.6-sol·terra·luna 모두 수용).
# 모델을 바꾸면 그 표부터 볼 것(haiku-4-5 는 effort 를 400 으로 거부).
#
# 미배정 기능은 기본(OPENAI_MODEL·ANTHROPIC_MODEL — provider 에 따라)으로 돈다.
# **오타는 조용히 무시되지 않고 기동 실패한다.**
# **이 값이 정본이다** — 리허설 워크플로(ai-llm-smoke)가 이 파일에서 읽어 운영과
# 같은 배정을 태운다. 바꾸면 팀 볼트 노트와 아래 vault-rev 도 같이 올린다.
AI_LLM_FEATURE_MODELS=PREFERENCE_SCORING=gpt-5.6-sol,INTENT=gpt-5.6-sol,PARAPHRASE=gpt-5.6-luna,REASON_INTERPRETATION=gpt-5.6-sol,EXPLANATION=gpt-5.6-sol,ALTERNATIVE_EXPLANATION=gpt-5.6-sol,ALTERNATIVE_SELECTION=gpt-5.6-sol,REFLECTION_NUDGE=gpt-5.6-luna,REMINDER_COPY=gpt-5.6-terra,REFLECTION_TEMPLATE=gpt-5.6-terra,PHOTO_HIGHLIGHT=gpt-5.6-terra,REFLECTION_TEMPLATE_VISION=gpt-5.6-terra,SHARE_CARD_COPY=gpt-5.6-sol,PLACE_EXTRACTION=gpt-5.6-sol,EVENT_EXTRACTION=gpt-5.6-sol,EDIT_TRANSLATION=gpt-5.6-sol,REPLAN_DIRECTIVE_TRANSLATION=gpt-5.6-sol,REPLAN_COMPOSITION=gpt-5.6-sol,REPLAN_REQUEST_EXTRACTION=gpt-5.6-sol,BANK_AUGMENT=gpt-5.6-sol,DIALOGUE_INTENT=gpt-5.6-luna,DIALOGUE_ANSWER=gpt-5.6-luna,DIALOGUE_MEMORY=gpt-5.6-luna

# ↑ 는 compose 가 읽는 바깥 이름이다. **로컬 스크립트는 아래 이름을 읽는다**
# (feature_model_env.py:23). 미러링해 두지 않으면 `set -a; source ../.env` 로
# 리허설을 돌릴 때 배정이 안 실려 **전부 OPENAI_MODEL 한 모델로 조용히 돈다** —
# 워크플로는 매핑하는데 로컬만 안 하는 어긋남이 생긴다(#445 가 없앤 바로 그것).
TRIPPILOT_LLM_FEATURE_MODELS=${AI_LLM_FEATURE_MODELS}

# 타임아웃 재시도 모델 (TRIP-522 2단 폴백) — 같은 형식. 1차 모델이 타임아웃하면 규칙
# 폴백 전에 이 모델로 한 번 더. 실측(2026-09-08, 실 PlanB 프롬프트) sol 5.0s · terra 5.2s ·
# opus 7.6s(편차 1.2) — 1차(sol)보다 빠른 모델은 없다.
#
# opus → terra (2026-09-12, 팀 결정 "가장 빨리 답변 주는 애로"). 재시도 몫 8.75초 대비
# 여유가 1초(opus 최대 7.8) → 3.5초(terra 최대 7.1)로 늘어난다. **대신 1차와 같은 벤더다** —
# sol 의 꼬리(최대 21초)가 Azure 쪽 사건이면 terra 도 같이 밟는다. 그 가설은 재현하지
# 못했으므로 운영 트레이스로 판정한다: `FallbackEvent(llm:gpt-5.6-sol→llm:gpt-5.6-terra)`
# 뒤 2차 성공률이 낮으면 벤더 상관의 증거이고, 그때 claude-opus-5 로 되돌린다(이 한 줄).
# 2026-10-14: GPT 로 되돌리며 재시도도 09-12 결정(terra)으로 복귀.
# mixed·anthropic 이어야 claude* 가 Anthropic 으로 간다. 비우면 재시도 없음(종전 동작).
AI_LLM_RETRY_MODELS=ALTERNATIVE_SELECTION=gpt-5.6-terra

# 취향 점수(PREFERENCE_SCORING) 병렬 청크 상한(TRIP-1313) — 생성 1회의 LLM 점수 호출 수다.
# 비우면 10. 내리면 호출이 그만큼 줄고 LLM 점수를 못 받은 후보는 규칙 점수로 채운다
# (`ScoreChunkEvent`·강등 노트로 드러난다). 0·음수는 기동 실패.
AI_SCORE_MAX_PARALLEL=

# 파인튜닝 학생 모델 (REMINDER_COPY) — 전송로가 둘이고 **둘 다 있으면 ARN 이 이긴다**
# (개발용 localhost 잔재로 실서비스가 나가는 것을 막는다, main.py::_local_route).
#
# ① 실서비스 — AWS Bedrock Custom Model Import. 서울 리전에 없어 us-east-1 등을 쓴다.
AI_BEDROCK_MODEL_ARN=
AI_BEDROCK_REGION=
# Bedrock 호출 자격 — 키 값은 여기 두지 않는다. ~/.aws/credentials 의 프로필 **이름만** 적는다
# (compose 가 ~/.aws 를 읽기 전용으로 붙인다). EKS 는 Pod Identity 라 키 자체가 없다.
AWS_PROFILE=
# ② 개발·검증 — OpenAI 호환 서버(MLX·vLLM). 예: http://host.docker.internal:8080/v1
# 모델명은 서빙의 --served-model-name 과 **정확히 일치**해야 한다(그대로 model= 로 나간다).
AI_LOCAL_LLM_BASE_URL=
AI_LOCAL_LLM_API_KEY=
# 학생 모델로 돌리려면 위 AI_LLM_FEATURE_MODELS 의 REMINDER_COPY 항목을 이 값으로 바꾼다(ARN 또는 base URL 필수):
#   REMINDER_COPY=local-reminder-qwen3-4b-v1
# Bedrock 은 5분 무호출이면 0 으로 내려가 첫 호출이 ModelNotReady → 그 배치는 상수 문구(INV-4), 적재는 약 2분.

# 요청당 비용 집계의 단가표 경로 — 비워 두면 이미지에 구운 `/app/config/llm-prices.json`
# 을 쓴다(단가는 공시가라 커밋돼 있다). 다른 표를 쓰려면 컨테이너 안 경로를 적고 그 파일을
# 볼륨으로 물린다. 호스트에서 직접 돌릴 땐 `ai/config/llm-prices.json`.
# 못 읽는 경로를 주면 기동 실패한다(의도 — 조용히 "비용 0" 이 되는 것보다 낫다).
# ↑ 위 FEATURE_MODELS 와 달리 **TRIPPILOT_ 미러를 두지 않는다** — 값이 컨테이너 안 경로라
# 호스트로 미러하면 `source .env` 로 돌릴 때 없는 파일을 가리켜 기동 실패한다.
# 호스트 실행은 미설정 = 집계 off(정상 동작)로 두고, 필요하면 그때만 손으로 넣는다.
AI_LLM_PRICE_FILE=

# 기상청 단기예보 디코딩 키(TRIP-383) — 설정 시 우천일 실내/야외 소프트 보정.
# ⚠ 공공데이터포털(data.go.kr) 키다 — 기상청 API허브 키를 넣으면 403 으로 거절되고 날씨 보정이
#   조용히 꺼진다(2026-10-01 실측). 비우면 보정 없음(AI 기동 시 WARN 1줄).
# 기상 조회 경로 — fake(기본) | kma.
# fake 는 격자 키 해시로 만든 가짜 강수확률이라 Plan-B 우천 트리거가 사실상 무작위다.
# kma 로 켜려면 아래 WEATHER_API 에 **일반 인증키(Decoding)** 가 있어야 한다(기동 시 검사).
WEATHER_MODE=fake

WEATHER_API=

# 기상특보·에어코리아·특일정보용 공공데이터포털 일반 인증키(Decoding). 비우면 WEATHER_API 를 쓴다(기능 PR 의 기본값).
PUBLIC_DATA_API_KEY=

# 카카오 로컬 REST 키(TRIP-683) — 설정 시 후보 POI 를 지도에서 찾아보고,
# 못 찾은 것의 **순위를 내린다**(배제 아님). 비우면 검증 없이 기존 경로 그대로.
#   · **비워 둬도 된다** — 위 소셜 로그인용 KAKAO_CLIENT_ID 로 폴백한다.
#     카카오 OAuth 는 client_id 자리에 **REST API 키**를 쓰므로 같은 값이고,
#     로컬 API 가 그대로 받는다(2026-09-16 실호출 확인: 키워드검색 200).
#   · 별도 키를 쓰고 싶을 때만 채운다. 행사 지오코딩 배치의
#     KAKAO_REST_API_KEY_AI 시크릿과 같은 키를 써도 된다
#     (무료 10만/일 대비 요청당 최대 50콜).
KAKAO_REST_API_KEY=
# verify() 1회당 호출 상한(기본 60). 보통 건드릴 일 없다 — 실질 제한은 마감 1.5s.
EXISTENCE_MAX_CALLS=

# PlanB RAG 벡터 스토어(TRIP-426·428) — --profile full 의 ai-vectordb 를 쓰면
# postgresql://... 형태. 비우면 대안 경계는 규칙 랭킹으로 동작.
AI_VECTOR_DB_URL=

# ── 임베딩 (PlanB KB 검색) ──────────────────────────────────────────
# provider: openai(기본) | titan | local | http
#   http = 별도 임베딩 컨테이너(TRIP-517). `--profile full` 로 ai-embedding 이 뜬다.
#   **provider 를 http 로 두면 적재도 http 로 해야 한다** — scripts/load_kb.py 가
#   같은 조립 함수를 쓴다. 안 그러면 적재와 질의가 다른 모델 인스턴스를 타는데,
#   둘 다 1024차원이라 DDL 도 어댑터 검증도 이걸 못 잡는다.
#   미설정이면 openai 로 떨어지는데 멘토 Azure 엔드포인트에는 임베딩 배포가 없어
#   404 가 난다 — 그래서 KB 검색 3종이 몇 주간 죽어 있었다(2026-09-01 발견).
AI_EMBEDDING_PROVIDER=http
# 컨테이너 안에서는 서비스명. 호스트에서 스크립트를 돌릴 땐 http://localhost:8100.
AI_EMBEDDING_BASE_URL=http://ai-embedding:8100
# 기본 nlpai-lab/KURE-v1. **바꾸면 KB 를 전량 재적재해야 한다**(벡터 공간 비호환,
# 팀 결정 2026-08-22). 어댑터가 서비스 응답의 model 과 대조해 불일치면 거부한다.
AI_EMBEDDING_MODEL=
# 요청 경로는 임베딩을 직렬 3회 부른다 — 이 값 × 3 이 검색 최악 소요다(기본 5초).
# 5초가 실질 상한이다: 3×5=15초에 LLM 몫 10초가 더 붙으면 요청 예산 20초를 넘는다.
# 워밍 후 정상 임베딩은 수백 ms 라, 이 값은 콜드스타트 보험이지 상시 비용이 아니다.
AI_EMBEDDING_TIMEOUT_SEC=

# ── IntentRouter 관측 (TRIP-653) — LangSmith ────────────────────────────
# 의도 라우팅 3단계를 트리로 보내 임계값을 튜닝한다. `LANGSMITH_TRACING=true`
# 일 때만 전송되고, 미설정이면 @traceable 이 함수를 그대로 통과시킨다
# (키 없어도 안 죽는다 · CI 외부 호출 0).
#
# ⚠️ 트리에는 발화 **원문**과 LLM 변형이 그대로 실린다. 로컬 튜닝용으로만 켠다.
#    운영 이미지에는 langsmith 자체가 없어(dev 그룹, TRIP-656) 배포 환경에서는 이 값을
#    켜도 아무것도 전송되지 않는다 — 운영 관측이 필요해지면 의존성 승격 + 마스킹·샘플링
#    (mlops-llmops-design §1.4)을 함께 결정한다. compose·CI 에는 일부러 관통시키지 않는다.
#
# 발화 주입은 아직 엔드포인트 미배선이라 scripts/intent/trace_intents.py 가 한다(TRIP-529).
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# 제휴 아웃바운드(C5). fallback = 웹검색(수수료 없음) · tripcom = 트립닷컴 딥링크.
# tripcom 은 세 값이 전부 있어야 기동한다 — AD_ID(= 생성기 등록 링크의 Ad ID, trip_sub3)가
# 빠지면 사용자는 정상 이동하는데 수수료만 조용히 사라진다(probe 실측 2026-10-01).
AFFILIATE_MODE=fallback
TRIPCOM_ALLIANCE_ID=
TRIPCOM_SID=
TRIPCOM_AD_ID=

# 도우미 발화 해석(U8). fake = 낱말 표 대역 · off = 버튼 모드(운영 값). http 는 AI 경계가 열리면 붙는다.
ASSISTANT_INTERPRET_MODE=fake
# 도우미 오케스트레이터(AI 쪽, assistant-orchestrator 1단계) — on | off(기본). 비우면 off = 종전 DialogueInterpreter 경로.
# on 이면 발화를 LLM 이 직접 분류하고(DIALOGUE_INTENT) 답을 짓고(DIALOGUE_ANSWER) 세션 메모리를 요약한다(DIALOGUE_MEMORY) —
# 배정은 위 AI_LLM_FEATURE_MODELS 의 세 항목. 끝까지 보려면 ASSISTANT_INTERPRET_MODE=http + ai 컨테이너(--profile full).
# 세션 메모리는 AI_VECTOR_DB_URL 의 ai_kb(dialogue_memory 테이블, 02-dialogue-memory.sql)에 산다 — 비우면 프로세스 안에만
# 남고 기동 WARN 한 줄. 기존 ai-vectordb 볼륨엔 initdb 가 다시 안 돌아 `docker compose down -v` 또는 수동 적용이 필요하다.
# 오타(true·yes)는 기동 실패다(조용한 기본값 금지).
AI_DIALOGUE_ORCHESTRATOR=
# 섀도 측정 — 기존 질문뱅크 IntentRouter 를 같은 발화로 그늘에서 돌려 일치율을 `intent_shadow` 로그 한 줄로 남기는 비율 0~1.
# 비우면 1.0(전부). DEV 1.0 · 운영 0.2 권고. 범위 밖은 기동 실패. 로그에 발화 원문·account_ref 는 실리지 않는다.
AI_DIALOGUE_SHADOW_RATE=
# 공휴일 휴무(AI, 상황 감지 H1) — on | off(기본). on 이면 생성·재계획·검증이 휴무 원문의 공휴일·명절·날짜 휴무를 함께 본다.
# 특일 달력 키는 WEATHER_API(같은 공공데이터포털 디코딩 키 — 특일정보 활용신청 필요). 로컬 compose 는 이 키만 넘긴다.
# 키가 없으면 날짜 명시형('1월 1일 휴관')만 쓰고 기동 WARN 한 줄. 오타(true·yes)는 기동 실패다.
HOLIDAY_CLOSURE_MODE=off

# 계정당 하루 AI 일정 생성 상한(TRIP-1314, 기본 10)과 상한을 받지 않는 개발자 계정 ID(쉼표 구분 UUID).
# 계정 ID 는 환경(DB)마다 다르다 — 로그인 후 GET /api/v1/me 의 accountId.
ITINERARY_GENERATION_DAILY_LIMIT=10
ITINERARY_GENERATION_LIMIT_EXEMPT_ACCOUNT_IDS=

# Plan-B 상황 감시 스윕(situation-awareness) — off(기본) | dry-run | on.
# dry-run = 감지·판정은 하되 요약 로그(planb.situation_sweep)만 남기고 쓰기 0. 켜는 순서는 dry-run 으로 1~2일 잰 뒤 on.
# 날씨 감지기는 WEATHER_MODE=kma 일 때만 산다(아니면 휴무만 본다). 오타는 서버 기동 실패다.
PLANB_SITUATION_SWEEP=off
# 지평 — today(기본) | tomorrow(저녁 20시대 회차가 진행 중 여행의 내일도 본다) | pre-trip(내일 시작하는 여행의 첫날까지).
PLANB_SITUATION_HORIZON=today
# 스윕 대상 계정(쉼표 구분 UUID) — 비우면 전원. 운영 카나리용(인가가 아니라 대상만 좁힌다).
# 계정 ID 는 환경(DB)마다 다르다 — 로그인 후 GET /api/v1/me 의 accountId.
PLANB_SITUATION_SWEEP_ACCOUNT_IDS=
# 위험이 감지되면 재계획 초안을 미리 짠다 — off(기본) | on(LLM 비용). 읽는 코드는 선계산 변경이 더한다.
PLANB_PREPARED_REPLAN=off
