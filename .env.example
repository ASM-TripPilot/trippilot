# vault-rev: 6
#
# 여기에 넣는 건 **팀원 전원 로컬에 같은 값이 필요한 것**만이다. 개인 계정 발급 키
# (TOUR_API_KEY 등), CI 전용 키(NAVER_SEARCH_* 등), 특정 서버 전용 자격은 넣지 않는다
# — 분류 기준은 docs/guides/로컬-개발-컨테이너.md §1-2.
#
# 볼트 노트를 고치면 위 숫자를 +1 해서 커밋한다 → 팀원이 pull 할 때 갱신 알림이 뜬다.
# 로컬 개발 시크릿 템플릿 — 복사해서 사용: cp .env.example .env
# .env 는 git 에서 제외됨(.gitignore). 실제 값은 각자 로컬에만 둔다.

# DB 슈퍼유저(로컬 컨테이너 부트스트랩용)
POSTGRES_PASSWORD=postgres

# 런타임 앱이 붙을 롤 (init/00-roles.sql 에서 생성)
DB_USER=app_user
DB_PASSWORD=app_user

# 소셜 로그인 시크릿 — 각 IdP 개발자 콘솔에서 발급.
# 채워야 소셜 로그인이 동작한다(빈 값이면 로그인 시도 시에만 실패, 기동엔 무영향).
# ⚠️ 실제 값은 팀 비밀번호 매니저로 전달받아 채울 것. Slack/git 평문 공유 금지.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# apple 은 p8 서명 + id_token JWKS 검증 구현 후 추가 예정.

# AI 일정 생성 경계 — 기본은 내장 Fake(AI 컨테이너 없이도 동작).
# 공동 통합테스트에서만 http 로 바꿔 실 AI 에 붙인다: docker compose --profile full up
# (fake|http 외의 값은 조용히 fake 로 남는다 — 기동 로그의 "일정 생성 경계 = ..." 줄로 확인할 것.)
AI_SCHEDULE_MODE=fake
# 일정 생성 시간제약(day1 5초 / 전체 20초)을 AI 에 실을지. 기본 false = 시간제약 없음(TRIP-474).
# true 로 켜면 종전 동작 그대로다 — 값은 지우지 않고 끄기만 했으므로 9월 재도입은 이 한 줄이다(TRIP-475).
# 끄면 우리가 기다려 주는 상한이 22초 → 610초가 되고, "멈춘 생성" 판정 기준도 함께 늘어난다.
AI_SCHEDULE_DEADLINE_ENFORCED=false

# 시한 **값**(위 플래그를 켰을 때만 쓰인다). 기본값이 곧 SLO 다 — day1 5초 · 전체 20초.
# 시한은 **목표치이지 하드 제약이 아니다**(PR #104, 2026-08-15 AI 트랙 제안 수용): AI 는 권고값으로
# 읽고 초과해도 완결 응답을 준다. 실측(TRIP-373)에서 취향 점수가 후보 건당 ~0.3초 선형이라 실전 풀은
# 이 안에 안 들어온다 — 실 LLM 경로 품질을 볼 때만 과도기 값으로 올린다(예: day1 30000 / 전체 90000).
# 소켓 read 상한은 여기서 파생하므로 따로 올릴 키가 없다.
AI_SCHEDULE_DAY1_DEADLINE_MS=5000
AI_SCHEDULE_TOTAL_DEADLINE_MS=20000
# AI 컨테이너 주소. compose 의 헬스핑과 경계 baseUrl 이 같이 쓴다.
AI_URL=http://ai:8000

# 지역 지오코딩 경계(국내강제 INV-U1-12) — 기본 스텁은 시드 8개(제주·부산·서울·경주·천안·속초시·사하구 등)만
# 국내로 알고 **나머지 지역명은 전부 국외로 판정해 차단한다**. 실 지역명으로 여행을 만들려면 kakao 로 바꾼다.
# 키는 위 KAKAO_CLIENT_ID(= 카카오 REST API 키)를 그대로 쓴다 — 별도 발급이 아니다.
# 단, 카카오 콘솔에서 카카오맵(OPEN_MAP_AND_LOCAL) 서비스를 켜야 한다(꺼져 있으면 403).
# kakao 인데 KAKAO_CLIENT_ID 가 비면 앱이 기동을 거부한다(국내강제가 조용히 꺼지는 것을 막는다).
PLACE_GEOCODE_MODE=stub

# 서비스 간 호출 자격증명(TRIP-393) — AI 수집 워크플로 등 외부가 /internal 경계를 부를 때 쓴다.
# **비우면 /internal 은 아무도 호출할 수 없다**(fail-closed). 사용자 로그인 토큰으로는 통과하지 못한다.
# 팀 비밀번호 매니저로 공유하고 아무 랜덤 문자열이나 쓰면 된다(예: openssl rand -hex 32).
SERVICE_AUTH_TOKEN=

# TMAP 실경로 API(TRIP-432) — 설정 시 ChainedTravelAdapter 활성화(실경로 → 하버사인 폴백).
# 미설정 = 기존 하버사인 추정 그대로. SK open API 콘솔에서 appKey 발급.
TMAP_API_KEY=

# 행사 저장소 경로(TRIP-421) — **기본으로 배선돼 있다**(ai/data/collected_events.json, 이미지에 동봉).
# 행사 보너스를 끄려면 빈 값으로 두고 컨테이너를 다시 띄운다. 저장소 정본은 collect-state 브랜치:
#   git show origin/collect-state:collected_events.json > ai/data/collected_events.json
# ⚠️ 아래 줄의 `#` 를 풀면 기능이 **꺼진다** — 값을 그대로 둬도 compose 기본값과 같지만,
#    비운 채 풀면(AI_EVENTS_STORE=) 미배선이 된다. 기본 동작을 원하면 주석인 채로 둘 것.
#AI_EVENTS_STORE=data/collected_events.json

# ── AI 실 LLM·부가 기능 (전부 선택 — 비우면 해당 기능만 꺼지고 일정 생성은 동작) ──
# ⚠️ 이름 주의: compose 가 읽는 키는 정확히 아래 이름이다.
#   (예: LLM_PROVIDER 가 아니라 AI_LLM_PROVIDER — 이름이 다르면 조용히 꺼진다)

# 실 LLM 스위치 — openai | anthropic | mixed.
#   openai    → 아래 OPENAI_* 4종 필수 (GPT-5.6 게이트웨이)
#   anthropic → ANTHROPIC_API_KEY 필수 (Claude 직접 호출, AI-D06)
#   mixed     → 양쪽 키 전부 필수 — 기능별로 GPT·Claude 혼용 (TRIP-513).
#               배정은 AI_LLM_FEATURE_MODELS 로 ("claude*" 모델명이면 Claude 로 감).
# 켰는데 해당 키가 없으면 ai 기동 실패(의도된 fail-fast).
# 비우면 UnwiredLlm: 점수는 규칙 폴백, 일정은 OR-Tools 가 낸다(scoring_mode=RULE 로 표시).
AI_LLM_PROVIDER=
# GPT-5.6 게이트웨이(멘토 Azure v1 표면) — 값은 팀 비밀번호 매니저에서.
# BASE_URL 은 /openai/v1 까지만, MODEL 은 gpt-5.6-terra|sol|luna, API 는 responses 고정.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API=
# Claude 직접 호출용(anthropic 선택 시) — console.anthropic.com 발급.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# 기능별 모델 배정 콤마 목록 — "FEATURE=model,…". 티어 해석보다 우선한다(TRIP-513).
# mixed 전용이 아니다 — openai 단독에서도 배포(terra/sol/luna)를 기능별로 나눌 수 있다.
#
# PlanB 대안 선택은 서비스 핵심이라 상위 배포(sol)로 올린다. 리허설
# (ai/scripts/smoke_planb.py)도 같은 값을 읽으므로 운영과 리허설이 다른 모델을 태우지 않는다.
#
# 유효한 feature: PREFERENCE_SCORING · INTENT · PARAPHRASE · REASON_INTERPRETATION ·
#   EXPLANATION · ALTERNATIVE_SELECTION · REFLECTION_NUDGE · REFLECTION_TEMPLATE ·
#   PLACE_EXTRACTION · EVENT_EXTRACTION · EDIT_TRANSLATION
# 미배정 기능은 기본(OPENAI_MODEL)으로 돈다. **오타는 조용히 무시되지 않고 기동 실패한다.**
# **이 값이 정본이다** — 리허설 워크플로(ai-llm-smoke)가 이 파일에서 읽어 운영과
# 같은 배정을 태운다. 바꾸면 팀 볼트 노트와 아래 vault-rev 도 같이 올린다.
AI_LLM_FEATURE_MODELS=ALTERNATIVE_SELECTION=gpt-5.6-sol,EXPLANATION=claude-sonnet-5,REFLECTION_TEMPLATE=claude-opus-5,REFLECTION_NUDGE=claude-haiku-4-5,PHOTO_HIGHLIGHT=claude-opus-5,REFLECTION_TEMPLATE_VISION=claude-opus-5

# 기상청 단기예보 디코딩 키(TRIP-383) — 설정 시 우천일 실내/야외 소프트 보정.
WEATHER_API=

# PlanB RAG 벡터 스토어(TRIP-426·428) — --profile full 의 ai-vectordb 를 쓰면
# postgresql://... 형태. 비우면 대안 경계는 규칙 랭킹으로 동작.
AI_VECTOR_DB_URL=

# ── 임베딩 (PlanB KB 검색) ──────────────────────────────────────────
# provider: openai(기본) | titan | local | http
#   http = 별도 임베딩 컨테이너(TRIP-517). `--profile full` 로 ai-embedding 이 뜬다.
#   **provider 를 http 로 두면 적재도 http 로 해야 한다** — scripts/load_kb.py 가
#   같은 조립 함수를 쓴다. 안 그러면 적재와 질의가 다른 모델 인스턴스를 타는데,
#   둘 다 1024차원이라 DDL 도 어댑터 검증도 이걸 못 잡는다.
#   미설정이면 openai 로 떨어지는데 멘토 Azure 엔드포인트에는 임베딩 배포가 없어
#   404 가 난다 — 그래서 KB 검색 3종이 몇 주간 죽어 있었다(2026-09-01 발견).
AI_EMBEDDING_PROVIDER=http
# 컨테이너 안에서는 서비스명. 호스트에서 스크립트를 돌릴 땐 http://localhost:8100.
AI_EMBEDDING_BASE_URL=http://ai-embedding:8100
# 기본 nlpai-lab/KURE-v1. **바꾸면 KB 를 전량 재적재해야 한다**(벡터 공간 비호환,
# 팀 결정 2026-08-22). 어댑터가 서비스 응답의 model 과 대조해 불일치면 거부한다.
AI_EMBEDDING_MODEL=
# 요청 경로는 임베딩을 직렬 3회 부른다 — 크게 잡으면 3배가 요청 예산을 먹는다(기본 3초).
AI_EMBEDDING_TIMEOUT_SEC=

# ── IntentRouter 관측 (TRIP-653) — LangSmith ────────────────────────────
# 의도 라우팅 3단계를 트리로 보내 임계값을 튜닝한다. `LANGSMITH_TRACING=true`
# 일 때만 전송되고, 미설정이면 @traceable 이 함수를 그대로 통과시킨다
# (키 없어도 안 죽는다 · CI 외부 호출 0).
#
# ⚠️ 트리에는 발화 **원문**과 LLM 변형이 그대로 실린다. 로컬 튜닝용으로만 켜고,
#    배포 환경에서 켜려면 마스킹·샘플링(mlops-llmops-design §1.4)이 먼저다.
#    그래서 compose·CI 에는 일부러 관통시키지 않는다.
#
# 발화 주입은 아직 엔드포인트 미배선이라 scripts/trace_intents.py 가 한다(TRIP-529).
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
