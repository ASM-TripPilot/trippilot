# OS
.DS_Store

# Env / secrets
.env
.env.*
!.env.example

# Editor
.idea/
.vscode/
*.iml

# Obsidian (개인 vault 설정)
.obsidian/

# Claude Code (로컬 전용 설정)
.claude/settings.local.json

# Kiro MCP 설정 (토큰 포함 — 로컬 전용)
.kiro/settings/

# 하네스 사이클 중간 산출물 (감사 추적용, 로컬 보존)
_workspace


# Bazel 심볼릭 링크·사용자 오버라이드
/bazel-*
.bazelrc.user

# 이미지에 넣을 산출물 스테이징 (Gradle 이 만든 jar 복사본 — 재생성 가능)
deploy/artifacts/

# Terraform and AWS deployment generated files (may contain credentials)
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
crash.log
crash.*.log
.terraformrc
terraform.rc
.coverage
htmlcov/
**/__pycache__/

# AWS 자격 파일은 리포 어디에도 두지 않는다 — 표준 위치 ~/.aws/credentials. 리포 안에 실수로 만들어도 안 올라가게.
.aws/
**/.aws/
