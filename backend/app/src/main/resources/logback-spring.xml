<?xml version="1.0" encoding="UTF-8"?>
<!--
  구조화 로깅(SECURITY-03 / PAT-OBS-01): stdout JSON, 상관 ID(traceId) MDC, 모듈 태그=logger_name.
  PII/토큰 마스킹은 프레임워크 레벨 컨버터로 구조적 강제(개별 로그문 재량 금지, NFR-U1-SEC-22).
  ⚠️ path/value 마스킹 목록은 MaskingLoggingTest 와 동기 유지.
-->
<configuration>
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <customFields>{"service":"trippilot-backend"}</customFields>
            <jsonGeneratorDecorator class="net.logstash.logback.mask.MaskingJsonGeneratorDecorator">
                <defaultMask>****</defaultMask>
                <!-- NFR-U1-SEC-22 로그 금지 필드 -->
                <path>password</path>
                <path>passwordHash</path>
                <path>token</path>
                <path>tokenHash</path>
                <path>accessToken</path>
                <path>refreshToken</path>
                <path>idToken</path>
                <path>id_token</path>
                <path>authorization</path>
                <path>Authorization</path>
                <path>authorizationCode</path>
                <path>oauthCode</path>
                <path>socialCode</path>
                <path>verificationToken</path>
                <path>resetToken</path>
                <path>email</path>
                <path>providerEmail</path>
                <path>birthDate</path>
                <path>birth_date</path>
                <!-- 값 패턴: Bearer 토큰 · 이메일 주소 -->
                <value>Bearer\s+[A-Za-z0-9\-._~+/]+=*</value>
                <value>[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}</value>
            </jsonGeneratorDecorator>
        </encoder>
    </appender>

    <!--
      OTLP 경로(TRIP-218) — SigNoz 수집.
      ⚠️ 위 JSON appender 의 마스킹은 **인코더 레벨**이라 이 경로에는 걸리지 않는다.
      그대로 두면 마스킹을 우회한 원문이 수집기로 나가므로 MaskingAppender 로 감싼다.
      LogMasker 의 규칙 목록은 위 path/value 목록과 동기 유지할 것.
    -->
    <appender name="OTLP_RAW" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
        <captureCodeAttributes>true</captureCodeAttributes>
        <captureMdcAttributes>*</captureMdcAttributes>
    </appender>
    <appender name="OTLP" class="com.trippilot.app.observability.MaskingAppender">
        <appender-ref ref="OTLP_RAW"/>
    </appender>

    <root level="INFO">
        <appender-ref ref="JSON"/>
        <appender-ref ref="OTLP"/>
    </root>
</configuration>
